# Lista separada por vírgulas, sem barra final.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Obrigatórias para enviar mensagens. Nunca use NEXT_PUBLIC_ nestas variáveis.
OPENAI_API_KEY=
# ID exato de um modelo de texto disponível no seu projeto, compatível com Responses.
OPENAI_MODEL=

# O backend deve terminar antes do timeout de 30 segundos do frontend.
OPENAI_TIMEOUT_SECONDS=25
OPENAI_MAX_OUTPUT_TOKENS=800

# Credenciais do aplicativo confidencial criado no portal Twitch para usar a IGDB.
# Não são as credenciais da OpenAI nem um login exigido dos usuários do chat.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Prazo total da pesquisa, incluindo autenticação e espera por consultas anteriores.
IGDB_TIMEOUT_SECONDS=5

# RAG local é opcional e começa desativado. O índice é construído fora do chat.
RAG_ENABLED=false
# Caminho relativo à pasta backend, ou caminho absoluto definido pelo desenvolvedor.
RAG_INDEX_PATH=.data/rag-index.json
# Somente demonstrações com documentos fictícios. Mantenha false com dados reais.
RAG_ALLOW_SYNTHETIC=false
# Score de ranking, NÃO probabilidade de verdade. Calibre com suas perguntas.
RAG_MIN_SCORE=0.35
