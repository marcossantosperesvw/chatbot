# Lista separada por vírgulas, sem barra final.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Obrigatórias para enviar mensagens. Nunca use NEXT_PUBLIC_ nestas variáveis.
OPENAI_API_KEY=
# ID exato de um modelo de texto disponível no seu projeto, compatível com Responses.
OPENAI_MODEL=

# O backend deve terminar antes do timeout de 30 segundos do frontend.
OPENAI_TIMEOUT_SECONDS=25
OPENAI_MAX_OUTPUT_TOKENS=800
